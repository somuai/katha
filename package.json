{
  "name": "katha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "eval": "tsx evaluations/run.ts",
    "test:browser": "node tests/browser-regression.mjs",
    "eval:live": "tsx tests/live-providers.ts --run-live --primary-only",
    "lint": "prettier --check client/src src evaluations tests"
  },
  "dependencies": {
    "@fastify/multipart": "latest",
    "@fastify/static": "latest",
    "@huggingface/transformers": "latest",
    "@js-temporal/polyfill": "latest",
    "@napi-rs/canvas": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "better-sqlite3": "latest",
    "csv-parse": "^7.0.3",
    "dotenv": "latest",
    "fastify": "latest",
    "music-metadata": "^12.4.0",
    "pdfjs-dist": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "sharp": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prettier": "^3.10.0",
    "tsx": "latest",
    "typescript": "latest"
  }
}
