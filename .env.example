# Required for hosted reasoning/vision and audio; server only.
GROQ_API_KEY=
TAVILY_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
PORT=3000
KATHA_DATA_DIR=./data
# Local embedding weights download on first use. Set off for lexical-only testing.
KATHA_EMBEDDINGS=on
# Optional benchmark credential; not required for ordinary use.
GEMINI_API_KEY=

# Optional named source connections. OAuth application credentials, not user passwords.
# Register http://localhost:3000/api/connections/gmail/callback (adjust port if changed).
# Enable Gmail API and configure consent/test users. gmail.readonly is a restricted scope.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register http://localhost:3000/api/connections/hubspot/callback.
# Request oauth + selected CRM object read scopes only; no write scopes.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Optional official Canva MCP app (not your Codex plugin credentials).
# Enable Canva MCP, register http://localhost:3000/api/connections/oauth/callback.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Official Notion MCP dynamically registers Katha: no preconfigured key required.
